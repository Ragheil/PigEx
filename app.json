{
  "expo": {
    "name": "PigEx",
    "slug": "baboypig",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LOGO.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/pigIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E1EADEFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pigex.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pigIcon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pigex.app",
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "726ea9dc-9498-4560-b149-1b64e4469874"
      }
    },
    "owner": "2021302638"
  }
}
